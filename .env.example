# Copy to .env and fill in values. .env is gitignored.
# Process environment variables still take precedence over this file.

# --- Z200BW device (SBXPC SDK) ---
DEVICE_PASSWORD=0          # comm key set on the device (required to enable sync)
DEVICE_IP=192.168.31.120
DEVICE_PORT=5005
DEVICE_MACHINE=1
# DEVICE_DLL_DIR=          # override only if DLLs live outside vendor-sdk

# --- PostgreSQL persistence ---
# PG_URL=jdbc:postgresql://localhost:5432/attendance
# PG_USER=postgres
# PG_PASSWORD=

# --- Portal admin (first account, role=admin) ---
# Seeded once at startup when Postgres mode is active.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# --- Google Sheets ---
# SPREADSHEET_ID=          # omit for in-memory demo mode
# SERVICE_ACCOUNT_KEY_PATH=
# PORT=8080
